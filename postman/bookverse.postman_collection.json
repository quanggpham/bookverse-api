          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validation error returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error body', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.details).to.be.an('array').that.is.not.empty;",
                  "  const fields = body.details.map(d => d.field);",
                  "  pm.expect(fields).to.include('title');",
                  "  pm.expect(fields).to.include('author');",
                  "});",
                  ""
                ]
              }
            }
