    {
      "name": "Data-driven: 100 books",
      "item": [
        {
          "name": "POST /api/books (data-driven)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "book",
                  "value": "{\n  \"title\": \"{{title}}\",\n  \"author\": \"{{author}}\",\n  \"isbn\": \"{{isbn}}\",\n  \"year\": {{year}},\n  \"category\": \"{{category}}\",\n  \"rating\": {{rating}},\n  \"description\": \"{{description}}\"\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "**Data-driven test.** Run with the Runner using `postman/100-books.csv` as the data file (100 iterations, one per row). Each row has its own title/author/isbn/year, so no two runs collide.\n\nHow to run:\n1. Collection → ▸ ▸ Run collection\n2. Choose this folder `Data-driven: 100 books`\n3. Data tab → select `postman/100-books.csv`\n4. Run\n\nThe test asserts `201` and that the created book echoes the request ISBN."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Derive a per-run unique ISBN from the data-file value so repeated runs never",
                  "// collide with the DB unique-ISBN constraint (the CSV ISBNs are fixed and would 409).",
                  "const base = pm.iterationData.get('isbn') || ('' + Date.now());",
                  "const run = Date.now() % 1000000;",
                  "pm.collectionVariables.set('isbn', base.slice(0, 6) + String(run).padStart(6, '0'));",
                  "pm.collectionVariables.set('title', pm.iterationData.get('title'));",
                  "pm.collectionVariables.set('author', pm.iterationData.get('author'));",
                  "pm.collectionVariables.set('year', pm.iterationData.get('year'));",
                  "pm.collectionVariables.set('category', pm.iterationData.get('category'));",
                  "pm.collectionVariables.set('rating', pm.iterationData.get('rating'));",
                  "pm.collectionVariables.set('description', pm.iterationData.get('description'));",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A 409 means this row already exists from a previous run - accept it as",
                  "// idempotent. Otherwise require a 201 create.",
                  "pm.test('Data-driven create returns 201 (or 409 if already seeded)', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Book echoes the CSV row', () => {",
                  "  if (pm.response.code !== 201) {",
                  "    pm.expect(pm.response.json().code).to.eql('ISBN_ALREADY_EXISTS');",
                  "    return;",
                  "  }",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.isbn).to.eql(pm.collectionVariables.get('isbn'));",
                  "  pm.expect(body.title).to.eql(pm.iterationData.get('title'));",
                  "  pm.expect(body.author).to.eql(pm.iterationData.get('author'));",
                  "  pm.expect(body.year).to.eql(Number(pm.iterationData.get('year')));",
                  "});",
                  ""
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "event": []
    }
