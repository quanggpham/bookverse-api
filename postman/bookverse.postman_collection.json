        {
          "name": "POST /api/books (create)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "book",
                  "value": "{\n  \"title\": \"{{title}}\",\n  \"author\": \"{{author}}\",\n  \"isbn\": \"{{isbn}}\",\n  \"year\": 2024,\n  \"category\": \"Science Fiction\",\n  \"rating\": 4.5,\n  \"description\": \"Created by Postman with a unique ISBN.\"\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Creates a book with a unique ISBN (generated by the pre-request script). The test captures the returned `id` into `bookId` so the folder's later requests can use it."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a fresh unique ISBN + name for this run.",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('isbn', '9' + String(now).slice(-12));",
                  "pm.collectionVariables.set('title', 'Postman Book ' + now);",
                  "pm.collectionVariables.set('author', 'Author ' + (now % 1000));",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST /api/books returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body matches schema', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id').that.is.a('number');",
                  "  pm.expect(body).to.have.property('title').that.is.a('string');",
                  "  pm.expect(body).to.have.property('author').that.is.a('string');",
                  "  pm.expect(body).to.have.property('isbn').that.equals(pm.collectionVariables.get('isbn'));",
                  "  pm.expect(body).to.have.property('category').that.equals('Science Fiction');",
                  "  pm.expect(body).to.have.property('rating').that.equals(4.5);",
                  "  pm.expect(body).to.have.property('createdAt').that.is.a('string');",
                  "  pm.expect(body).to.have.property('updatedAt').that.is.a('string');",
                  "});",
                  "pm.test('Captures id for later requests', () => {",
                  "  pm.collectionVariables.set('bookId', pm.response.json().id);",
                  "});",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
