    {
      "name": "Cover images",
      "item": [
        {
          "name": "POST /api/books (create WITH cover)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "book",
                  "value": "{\n  \"title\": \"{{coverTitle}}\",\n  \"author\": \"Cover Author\",\n  \"isbn\": \"{{coverIsbn}}\",\n  \"year\": 2023,\n  \"category\": \"Cover Art\",\n  \"rating\": 4.0,\n  \"description\": \"Book created with a cover image.\"\n}",
                  "type": "text",
                  "description": "The JSON part (multipart part named `book`)",
                  "contentType": "application/json"
                },
                {
                  "key": "cover",
                  "value": "sample-cover.png",
                  "type": "file",
                  "src": "postman/sample-cover.png",
                  "description": "The image part (multipart part named `cover`). Select the PNG from postman/."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Multipart create with a cover image. The server resizes to 3 sizes (thumb/medium/large), converts to WebP and stores under uploads/covers/yyyy/MM/{id}-*.webp.\n\n⚠️ **You must select `postman/sample-cover.png` on the `cover` part** after import (Postman stores the file path per-machine). See the README."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('coverIsbn', '8' + String(now).slice(-12));",
                  "pm.collectionVariables.set('coverTitle', 'Cover Book ' + now);",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create-with-cover returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('coverPath is set', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.coverPath).to.be.a('string').that.is.not.empty;",
                  "  pm.collectionVariables.set('coverId', body.id);",
                  "  pm.collectionVariables.set('coverPath', body.coverPath);",
                  "});",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/books/{{coverId}}/cover?size=thumb",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{coverId}}/cover?size=thumb",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{coverId}}",
                "cover"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "thumb",
                  "description": "Allowed: thumb, medium, large (default: large)"
                }
              ]
            },
            "description": "Serve the thumbnail WebP. The test checks the `Content-Type` is `image/webp` and that the body bytes are a WebP image."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cover thumb returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is image/webp', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.contain('image/webp');",
                  "});",
                  "// Magic-byte check: the Postman desktop app buffers the body so arrayBuffer is",
                  "// available; newman does not expose it for binary responses, in which case the",
                  "// assertion simply passes on the header checks above (the server returns a real",
                  "// WebP — verified independently by curl in this collection's README).",
                  "pm.test('Body is a WebP file (when body is buffered)', () => {",
                  "  const ab = pm.response.arrayBuffer;",
                  "  if (!ab || !ab.byteLength) {",
                  "    console.log('arrayBuffer unavailable (likely newman) - skipping magic-byte check');",
                  "    return; // pass on header checks",
                  "  }",
                  "  const bytes = new Uint8Array(ab.slice(0, 12));",
                  "  const ascii = String.fromCharCode.apply(null, bytes);",
                  "  pm.expect(ascii.startsWith('RIFF')).to.be.true;",
                  "  pm.expect(ascii.endsWith('WEBP')).to.be.true;",
                  "});",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
